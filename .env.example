# Google Gemini 2.5 Flash — completely free, no credit card required
# 1. Go to aistudio.google.com
# 2. Click "Get API key" → Create API key
# 3. Add to Vercel: Project → Settings → Environment Variables → GOOGLE_GENERATIVE_AI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=

# Auth — Clerk (https://dashboard.clerk.com)
# 1. Create a free Clerk application
# 2. Copy the two API keys from "API Keys" in the dashboard
# 3. Enable sign-in methods (Email, Google, Facebook, X) under "User & Authentication"
# Until these are set, the app stays open (no login required).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Also set in Clerk so login uses Brève's own pages (not the hosted portal):
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up

# Summary cache — Vercel KV (Upstash Redis)
# Create a KV store: Vercel → Storage → Create → KV, then "Connect Project".
# Vercel auto-injects these; no need to copy them manually. Without them the
# app falls back to a per-instance in-memory cache (works, just less durable).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Database — Neon PostgreSQL (free tier, https://neon.tech)
# Run db/schema.sql against a new project, then paste the connection string.
# Without it the app serves live RSS only (no clustering/coverage/prefs sync).
DATABASE_URL=

# Cron auth — protects /api/ingest and /api/push/send
# Generate: openssl rand -hex 32
# Also add APP_URL + CRON_SECRET as GitHub repo secrets for the workflows.
CRON_SECRET=

# Web Push (morning brief notifications) — free VAPID keys
# Generate: npx web-push generate-vapid-keys
# Without these, push features stay silently hidden.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
