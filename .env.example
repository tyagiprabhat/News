# Google Gemini 2.5 Flash — completely free, no credit card required
# 1. Go to aistudio.google.com
# 2. Click "Get API key" → Create API key
# 3. Add to Vercel: Project → Settings → Environment Variables → GOOGLE_GENERATIVE_AI_API_KEY
GOOGLE_GENERATIVE_AI_API_KEY=

# Auth — invite-only beta
# AUTH_SECRET: any long random string (e.g. `openssl rand -hex 32`)
# AUTH_USERS: comma-separated username:password pairs for your invited users
AUTH_SECRET=
AUTH_USERS=alice:changeme1,bob:changeme2
